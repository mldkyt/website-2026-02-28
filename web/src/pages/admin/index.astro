---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";

import Buttons from "@components/Buttons.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="lain" description="lain is a cute girl programmer making projects, YouTube videos and sometimes streams." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Admin panel :fire:</h1>

                <ul>
                    <li><a href="/admin/guestbook">Guestbook manager</a></li>
                    <li><a href="/admin/anonymousmessages">Anonymous Messages Manager</a></li>
                </ul>
            </main>

            <Footer />
        </div>
        <script is:inline src="/scripts/background.js"></script>
    </body>
</html>
