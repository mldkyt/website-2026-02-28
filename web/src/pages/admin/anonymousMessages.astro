---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="lain" description="lain is a cute girl programmer making projects, YouTube videos and sometimes streams." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Anonymous Messages Manager</h1>

                <h2>Unanswered Messages</h2>

                {"[[range .Messages]]"}
                <div style="border: 1px solid white; padding: 4px; margin: 4px;">
                    <p>Message: [[.Message]]</p>
                    <p><small>IP: [[.IP]]</small></p>

                    <form method="post" action="/admin/anonymousmessages">
                        <input type="hidden" name="id" value="[[.ID]]" />
                        <textarea name="reply" cols="60" rows="5"></textarea>
                        <button type="submit">Send back</button>
                    </form>

                    <a href="/admin/anonymousmessages?delete=[[.ID]]">Delete</a>
                    <a href="/admin/anonymousmessages?ban=[[.ID]]">Ban user</a>
                </div>
                {"[[end]]"}

                <h2>Bans</h2>

                <table>
                    <thead>
                        <tr>
                            <th>Banned IP</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {"[[range .Bans]]"}
                        <tr>
                            <td>[[.IP]]</td>
                            <td><a href="/admin/anonymousmessages?unban=[[.ID]]">Unban</a></td>
                        </tr>
                        {"[[end]]"}
                    </tbody>
                </table>
            </main>

            <Footer />
        </div>
        <script is:inline src="/scripts/background.js"></script>
    </body>
</html>
