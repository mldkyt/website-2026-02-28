---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="lain" description="lain is a cute girl programmer making projects, YouTube videos and sometimes streams." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Guestbook manager</h1>

                <h2>Unapproved posts</h2>

                {"[[range .UnapprovedPosts]]"}
                <div style="border: 1px solid white; padding: 4px; margin: 4px;">
                    <p>Name: [[.Name]]</p>
                    <p>Message: [[.Message]]</p>
                    <p><small>IP: [[.IP]]</small></p>
                    <a href="/admin/guestbook?approve=[[.ID]]">Approve</a>
                    <a href="/admin/guestbook?delete=[[.ID]]">Delete</a>
                    <a href="/admin/guestbook?ban=[[.ID]]">Post Ban</a>
                    <a href="/admin/guestbook?banfull=[[.ID]]">Full Ban</a>
                </div>
                {"[[end]]"}

                <h2>Approved posts</h2>

                {"[[range .ApprovedPosts]]"}
                <div style="border: 1px solid white; padding: 4px; margin: 4px;">
                    <p>Name: [[.Name]]</p>
                    <p>Message: [[.Message]]</p>
                    <p>Reply: [[.Reply]]</p>
                    <form action="/admin/guestbook" method="post">
                        <input type="hidden" name="id" value="[[.ID]]" />
                        <input type="text" name="reply" id="reply" placeholder="lain..." />
                        <button type="submit">Set reply</button>
                    </form>
                </div>
                {"[[end]]"}

                <h2>Bans</h2>

                <table>
                    <thead>
                        <tr>
                            <th>Banned IP</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {"[[range .Bans]]"}
                        <tr>
                            <td>[[.IP]]</td>
                            <td>[[.FullBan]]</td>
                            <td><a href="/admin/guestbook?unban=[[.ID]]">Unban</a></td>
                        </tr>
                        {"[[end]]"}
                    </tbody>
                </table>
            </main>

            <Footer />
        </div>
        <script is:inline src="/scripts/background.js"></script>
    </body>
</html>
