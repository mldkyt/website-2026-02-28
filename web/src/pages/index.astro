---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";

import Buttons from "@components/Buttons.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Lunya" description="Lunya is a cute girl programmer making projects, YouTube videos and sometimes streams." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Welcome to Lunya's website!</h1>

                <br />
                <div class="buttons">
                    <img src="/buttons/made_with_windows.gif" alt="Made with Windows" width="88" height="31" />
                    <img src="/buttons/site_best_viewed_with_monitor.gif" alt="Best viewed with monitor" width="88" height="31" />
                    <img src="/buttons/yokoso_approved.gif" alt="Yokoso approved" width="88" height="31" />
                </div>
                <br />

                <h2>about me uwu</h2>
                <p>i'm a transgender catgirl, and i <a href="https://git.lunya.pet/Lunya">code</a>! alongside coding, i also <a href="https://youtube.com/@LunyaUwU">make videos</a>!</p>
                <p>my most successfull project is <a href="/project/akabot">Akabot</a>, a general purpose discord bot with a lot of features :3 it's one of the <a href="/projects">cool projects</a> you can find!</p>
                <p>if you want a live feed of my magic, join fedi and follow <a href="https://fedi.lunya.pet/@Lunya" rel="me">@Lunya@fedi.lunya.pet</a>. :3</p>

                <p>
                    <a href="https://fediring.net/previous?host=lunya.pet"><button>←</button></a>
                    <a href="https://fediring.net/"><button>Fediring</button></a>
                    <a href="https://fediring.net/next?host=lunya.pet"><button>→</button></a>
                </p>

                <h3><a href="/projects">projects</a></h3>
                <ul>
                    <li>
                        <a href="/project/akabot"><strong>Akabot</strong></a> is a general purpose discord bot with a lot of features.
                    </li>
                    <li>
                        <a href="/project/astolfoiscomingforyou"><strong>Astolfo is coming for you</strong></a> astolfo comes for you as a windows program! comfy and evil variations :3
                    </li>
                    <li>
                        <a href="/project/astolfoforge"><strong>Astolfo Mod</strong></a> adds a bunch of femboys and transgirls into minecraft :3
                    </li>
                    <li>
                        <a href="/project/catgirlnonsense"><strong>Catgirl nonsense generator</strong></a> catgirls dreams mmwrmwamrwamrmwa &gt;/////////&lt; wrwageiogjaa uwu :3 *pats you*
                    </li>
                </ul>

                <h2>88x31 buttons</h2>

                <h3 id="my-button">my button</h3>
                You can add my button on your website. Please link back when you do so. You'll also probably need to host it yourself.
                <br />
                <img src="/button.gif" alt="88x31 button" />

                <br />
                <br />

                <h3 id="buttons">buttons</h3>
                <Buttons />
            </main>

            <Footer />
        </div>
        <script is:inline src="/scripts/background.js"></script>
    </body>
</html>
