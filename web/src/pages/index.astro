                    </li>
                </ul>

                <h2>Webrings</h2>

                <p>
                    <a href="https://fediring.net/previous?host=lunya.pet"><button>←</button></a>
                    <a href="https://fediring.net/"><button>Fediring</button></a>
                    <a href="https://fediring.net/next?host=lunya.pet"><button>→</button></a>
