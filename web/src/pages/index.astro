---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";

import Buttons from "@components/Buttons.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Lunya" description="Lunya is a cute girl programmer making projects, YouTube videos and sometimes streams." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Welcome to Lunya's website!</h1>

                <h2>About me</h2>
                <p>
                    Hi, I'm Lunya, and I'm a silly transgender lesbian catgirl (yes that's a spell), and I <a href="https://git.lunya.pet/Lunya" target="_blank">code in production</a>, make <a
                        href="https://youtube.com/@lunyauwu"
                        target="_blank">YouTube videos</a
                    > and <a href="https://sk.lunya.pet/@lunya" target="_blank">shitpost on fedi</a>! I have a <a href="/discord" target="_blank">Discord</a> server and <a href="https://forums.lunya.pet" target="_blank">forums</a> :3
                </p>

                <p>
                    I write my code in a lot of programming languages, the choice of course based on which programming language I know best for the task. I've written projects in C, C++, Java, Kotlin, JavaScript, TypeScript, Go, Rust, HTML,
                    CSS, Python, Astro and others in the past.
                </p>

                <p>
                    On YouTube, I've published mostly <a href="https://www.youtube.com/watch?v=7RT3EZiDEeE&list=PLBuV8_rRvRfDdSWKlJBUNhzGo-Qgzi_nk&pp=gAQB" target="_blank">videos about My Summer Car</a>, <a
                        href="https://www.youtube.com/watch?v=kebvJDNGDr0&list=PLBuV8_rRvRfDXeLbrypTB88hhOCZzLMcw&pp=gAQB"
                        target="_blank">Mon Bazou</a
                    >, <a href="https://www.youtube.com/watch?v=Rk5XmItKA1w&list=PLBuV8_rRvRfDDmQTZZ_F-L-PQkVAeMYBo&pp=gAQB" target="_blank">Minecraft</a>, <a
                        href="https://www.youtube.com/watch?v=9-O8-Y6f818&list=PLBuV8_rRvRfD36HvpMg6BnfeLVzBVS5sq&pp=gAQB"
                        target="_blank">Celeste</a
                    > and other games. Some of these videos are tutorials, some have a vTuber like appearance, some document my own projects, others are just shitposts. <a href="https://youtube.com/@lunyauwu" target="_blank"
                        >You're welcome to check out my YouTube channel</a
                    >.
                </p>

                <p>
                    Wanna read a more personal "about me"? <a href="/about-me">Read about me~</a> :3 Otherwise, check out the things I've done:
                </p>

                <h3><a href="/projects">Programming Projects</a></h3>
                <ul>
                    <li>
                        <a href="https://akabot.xyz"><strong>Akabot</strong></a> is a general purpose discord bot with over 30 features. <a href="https://git.lunya.pet/lunya/nekona">Nekona</a> is an upcoming rewrite.
                    </li>
                    <li>
                        Wanna be invaded by Astolfo? <a href="/project/astolfoiscomingforyou"><strong>Astolfo is coming for you</strong></a> is a Windows program that recreates the meme.
                    </li>
                    <li>
                        Ever felt like a catgirl? <a href="/project/catlikebehaviourdetected">Cat Like Behaviour Detected</a> is for you.
                    </li>
                    <li>
                        <a href="/project/astolfoforge"><strong>Astolfo Mod</strong></a> adds a bunch of femboys and transgirls into minecraft :3
                    </li>
                    <li>
                        <a href="/project/catgirlnonsense"><strong>catgirls dreams mmwrmwamrwamrmwa &gt;/////////&lt; wrwageiogjaa uwu :3 *pats you*</strong></a>
                    </li>
                </ul>

                <h3><a href="https://youtube.com/@lunyauwu">Latest YouTube videos</a></h3>

                <ul>
                    {"[[range .Videos]]"}
                    <li><a href="[[.Link]]"><strong>[[.Title]]</strong></a></li>
                    {"[[end]]"}
                </ul>

                <p>Some of these videos also get mirrored to <a href="https://pt.lunya.pet/c/lunyavids" target="_blank">PeerTube</a>.</p>

                <br />
                <details>
                    <summary>Webrings</summary>
                    <p>
                        <a href="https://fediring.net/previous?host=lunya.pet"><button>←</button></a>
                        <a href="https://fediring.net/"><button>Fediring</button></a>
                        <a href="https://fediring.net/next?host=lunya.pet"><button>→</button></a>
                    </p>

                    <div style="text-align:center">
                        <a href="https://baccyflap.com/noai/?prv&s=aka" target="_top">« prev</a> |
                        <a href="https://baccyflap.com/noai" target="_blank">no ai webring</a>
                        <a style="font-size:60%" href="https://baccyflap.com/noai/?rnd" target="_top">(random)</a> |
                        <a href="https://baccyflap.com/noai/?nxt&s=aka" target="_top">next »</a>
                    </div>
                </details>
                <br />

                <h2>Buttons</h2>

                <Buttons />

                <p><small>If you decide to add my button, please <a href="/button">check here!</a></small></p>

                <br />
                <br />

                <Footer />
            </main>
            <script is:inline src="/scripts/background.js"></script>
        </div>
    </body>
</html>
