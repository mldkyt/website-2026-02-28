---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Donate" description="Lunya accepts donations, so if you got some spare money, please donate!" />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Donate</h1>

                <p>Do you like my work? You can support me &lt;3</p>

                <p>My primary way of receiving donations is <a href="https://ko-fi.com/LunyaUwU">Ko-fi</a>. Simply visit the site, and follow instructions to donate (buy a coffee).</p>

                <p>When you donate, I'll thank you and you'll support me and motivate me to make more content. Thank you &lt;3</p>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
