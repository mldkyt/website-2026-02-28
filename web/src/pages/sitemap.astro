---
import Cursor from "@components/cursor.astro";
import Footer from "@components/footer.astro";
import Header from "@components/header.astro";
import Meta from "@components/meta.astro";
import Scripts from "@components/scripts.astro";

// Load all pages eagerly
const allPagesImport = import.meta.glob("../pages/**/*.astro", { eager: true });

// Convert file paths to URLs
const allPages = Object.keys(allPagesImport).map((path) => {
    return path
        .replace("../pages", "") // Remove the base folder
        .replace("/index.astro", "/") // Convert index pages to "/"
        .replace(".astro", "") // Remove file extensions
        .replace(/^[.]\//, '/'); // Remove thingy at start
}).filter(x => x !== '/');
---

<html>
    <head>
    <Meta name="Sitemap"
          description="Explore the entirety of the website with the sitemap! You can see a full list of all pages here :3"/>
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Sitemap</h1>
                <ul>
                    <li><a href="/">/</a></li>
                    {allPages.map((page) => {
                                    return (
                                        <li>
                                            <a href={page}>{page}</a>
                                </li>);
                    })}
                </ul>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
