---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Lunya's Blog" description="Welcome to Lunya's blog. Here are all of her posts! :3" />
        <Scripts />
        <Cursor />
        <style>
            .post {
                border: 1px solid white;
                margin: 4px;
                padding: 4px;
                padding-top: 8px;
                padding-bottom: 8px;
            }

            .post span {
                margin: 4px;
            }

            .post h3,
            .post span {
                text-decoration: none;
                color: white;
            }
        </style>
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>blog</h1>
                <p>welcome to my blog! if you don't know me, <a href="/">I'm Lunya, and this is my personal page</a>.</p>

                <p>browse my blog here! every blog post has a small description and you can read them by clicking them. you can also <a href="/rss.xml">subscribe to the RSS feed</a>.</p>

                <h2>June 2025</h2>

                <a href="/blog/2025/06/01-updating-usernames" style="text-decoration: none;">
                    <div class="post">
                        <div style="display: flex; justify-content: space-between;">
                            <h3>Updating usernames on all social platforms</h3>
                            <span>2025/06/01</span>
                        </div>
                        <span>I am updating usernames on all platforms, and here's why</span>
                    </div>
                </a>

                <h2>February 2025</h2>
                <a href="/blog/2025/02/08-msc-mods" style="text-decoration: none;">
                    <div class="post">
                        <div style="display: flex; justify-content: space-between;">
                            <h3>Why I won't fix my My Summer Car mods</h3>
                            <span>2025/02/08</span>
                        </div>
                        <span>Explaining that these mods are unsupported, and it's up to the user to downgrade MSCLoader or fix the mods themself.</span>
                    </div>
                </a>

                <h2>May 2024</h2>
                <a href="/blog/2024/05/04-enhancing-our-community" style="text-decoration: none;">
                    <div class="post">
                        <div style="display: flex; justify-content: space-between;">
                            <h3>Enhancing Our Community: Discord Server Rules Update</h3>
                            <span>2024/05/04</span>
                        </div>
                        <span
                            >Updated Discord Server Rules: Learn about recent changes to our Discord community guidelines, including revised humor guidelines and NSFW/Lewd content policies. Help us maintain a fun, safe, and inclusive
                            environment for all members.</span
                        >
                    </div>
                </a>

                <h2>April 2024</h2>
                <a href="/blog/2024/04/28-new-domain" style="text-decoration: none;">
                    <div class="post">
                        <div style="display: flex; justify-content: space-between;">
                            <h3>New domain</h3>
                            <span>2024/04/28</span>
                        </div>
                        <span>Lunya's new domain</span>
                    </div>
                </a>

                <h2>December 2023</h2>
                <a href="/blog/2023/12/22-akabot-1-1" style="text-decoration: none;">
                    <div class="post">
                        <div style="display: flex; justify-content: space-between;">
                            <h3>Akabot 1.1</h3>
                            <span>2023/12/22</span>
                        </div>
                        <span>Akabot was updated to 1.1</span>
                    </div>
                </a>
                <a href="/blog/2023/12/21-akabot-1-01" style="text-decoration: none;">
                    <div class="post">
                        <div style="display: flex; justify-content: space-between;">
                            <h3>Akabot 1.01</h3>
                            <span>2023/12/21</span>
                        </div>
                        <span>Akabot was updated to 1.01</span>
                    </div>
                </a>
                <a href="/blog/2023/12/15-akabot-release" style="text-decoration: none;">
                    <div class="post">
                        <div style="display: flex; justify-content: space-between;">
                            <h3>Akabot Release</h3>
                            <span>2023/12/15</span>
                        </div>
                        <span>The release of the Discord bot, Akabot.</span>
                    </div>
                </a>

                <h2>November 2019</h2>
                <a href="/blog/2019/11/26-the-beginning" style="text-decoration: none;">
                    <div class="post">
                        <div style="display: flex; justify-content: space-between;">
                            <h3>The Beginning</h3>
                            <span>2019/11/26</span>
                        </div>
                        <span>Where Lunya started.</span>
                    </div>
                </a>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
