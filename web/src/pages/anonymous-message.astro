---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
<head>
    <Meta name="Lunya's Button" description="Lunya finally made an 88x31 button for her website! Add it to your website and link back when you do so!" />
    <Scripts />
    <Cursor />
    <script type="text/javascript" defer src="https://nekochat.mldchan.dev/js/nekochat.js" />
    <link rel="stylesheet" href="https://nekochat.mldchan.dev/css/nekochat.css" />
    <style>
        .error {
            background-image: linear-gradient(to bottom, rgb(136, 0, 0) 20%, rgb(78, 0, 0) 50%, rgb(150, 1, 1) 100%);
            color: white;
            border: 2px solid red;
            padding: 10px;
        }

        .ok {
            background-image: linear-gradient(to bottom, rgb(41, 136, 0) 20%, rgb(8, 78, 0) 50%, rgb(11, 150, 1) 100%);
            color: white;
            border: 2px solid lime;
            padding: 10px;
        }
    </style>
</head>

<body>
<canvas id="background"></canvas>
<!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
<div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
    <Header />
    <main>
        <h1>Send an anonymous message to Lunya!</h1>

        [[if .Error]]
        <div class="error">
            <span>An error occured submitting the request</span>
        </div>
        [[end]]

        [[if .OK]]
        <div class="ok">
            <span>Sent!</span>
        </div>
        [[end]]

        <form method="post" action="/api/anonymous-message">
            <label for="cw">Content Warning</label>
            <br />
            <input type="text" id="cw" name="cw" style="width: 100%;" />
            <br />
            <label for="message">Message</label>
            <br />
            <textarea id="message" name="message" style="width: 100%;" />
            <br />
            <button type="submit">Submit</button>
        </form>
    </main>

    <Footer />
</div>
<script is:inline src="/scripts/background.js"></script>
</body>
</html>
