---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Lunya's Guestbook" description="Lunya's guestbook: Sign your visit to this website!" />
        <Scripts />
        <Cursor />
        <style>
            .error {
                border: 1px solid red;
                background-image: linear-gradient(to bottom, rgb(136, 0, 0) 20%, rgb(78, 0, 0) 50%, rgb(150, 1, 1) 100%);
                padding: 2px;
            }
        </style>
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Lunya's Guestbook</h1>

                <h2>Rules</h2>
                <ol start="1">
                    <li>Do not post harassing, discriminatory content, nwords, rwords, 9/11 references and so on and so on here. Please.</li>
                    <li>Respect other people's preferences and decisions. Don't harass a person simply because they use Windows.</li>
                    <li>No content that's illegal in the Czech Republic and the EU. Please don't post this content.</li>
                </ol>

                <br />

                <iframe src="https://lunya.atabook.org" frameborder="0" width="800" height="600"></iframe>

                <br />
            </main>
            <Footer />
        </div>
        <script is:inline src="/scripts/background.js"></script>
    </body>
</html>
