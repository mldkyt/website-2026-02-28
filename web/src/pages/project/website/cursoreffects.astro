---
import "@styles/global.module.css";
import Meta from "@components/meta.astro";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";

import buttonSrc from "@components/btn/button.png";
import {getImage} from "astro:assets";

const button = await getImage({ src: buttonSrc});
---

<html>
    <head>
        <Meta name="Cursor Effects | Website | Projects" description="Lunya's cursor effects on her website." />
        <Scripts />
        <Cursor />

        <style>
            .error {
                background-image: linear-gradient(to bottom, rgb(136, 0, 0) 20%, rgb(78, 0, 0) 50%, rgb(150, 1, 1) 100%);
                padding: 4px;
                border: 1px solid red;
            }
        </style>
    </head>

    <body>
        <canvas id="background"></canvas>
        <div id="abovebackground" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
            <Header />
            <main>
                <h1>The Cursor Effects</h1>
                <a href="/project/website">&lt; Go back to full list</a>

                <h2>How do I add cursor effects to my website?</h2>
                <ol start="1">
                    <li>
                To add cursor effects to your website, <a
                    href="https://github.com/tholman/cursor-effects?tab=readme-ov-file#how-to-use">follow this link</a>
                    </li>
                    <li>
                        Append the script tag that's visible as the first thing in the head tag of your website. <br />
                        <i>Optionally open it and save it in your project and host it on your own.</i>
                    </li>
                    <li>Create a script tag under this script tag to add your cursor effects. Look below for examples.</li>
                    <li>
                        Here's my configuration, which you can copy and paste and it will give you a non-binary cursor: <br />
                        <code>
                    cursoreffects.fairyDustCursor(&lbrace; <br/> colors: ["#f3d100", "#ffffff", "#9656cd", "#000000"],
                    <br/> &rbrace;); <br/> cursoreffects.rainbowCursor(&lbrace; <br/> colors: ["yellow", "white",
                    "purple", "black"],
                            <br /> length: 50, <br /> size: 5, <br /> &rbrace;);
                        </code>
                    </li>
                    <li>
                Here's my older configuration, which you can copy and paste and it will give you a transgender themed
                cursor: <br/>

                        <code>
                            cursoreffects.fairyDustCursor(&lbrace; <br />
                            colors: ["#f3d100", "#ffffff", "#9656cd", "#000000"], <br />
                            &rbrace;); <br />
                            cursoreffects.rainbowCursor(&lbrace; <br />
                            colors: ["yellow", "white", "purple", "black"], <br />
                            length: 50, <br />
                            size: 5, <br />
                            &rbrace;);
                        </code>
                    </li>
                    <li>Customize and create your own configuration by following the documentation</li>
                    <li>If you like this guide and/or used my code, please add my button that's right below!</li>
                </ol>

                <br />

                <h2>Please credit me!</h2>
                <p>You can add the button from right below here:</p>
                <img src={button.src} alt="Button" />
        <p>Make sure to wrap it with an <code>&lt;a&gt;</code> tag to make it a link and set the <code>href</code> to
            <code>mldkyt.nekoweb.org</code></p>
            </main>
            <Footer />

            <script is:inline defer src="/scripts/background.js"></script>
        </div>
    </body>
</html>
