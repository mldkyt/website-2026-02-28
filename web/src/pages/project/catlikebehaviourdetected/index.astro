---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";

import img1Src from "./img1.png";

import { getImage } from "astro:assets";

const img1 = await getImage({ src: img1Src });
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Cat-Like Behaviour Detected" description="A joke program that shows a cat-like behaviour detected dialog" />
        <Scripts />
        <Cursor />
        <style>
            .error {
                border: 1px solid red;
                background-image: linear-gradient(to bottom, rgb(136, 0, 0) 20%, rgb(78, 0, 0) 50%, rgb(150, 1, 1) 100%);
                padding: 2px;
            }
        </style>
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Cat-Like Behaviour Detected</h1>

                <p>This is a joke program that shows a "Cat-Like Behaviour Detected" window. This window is currently purely decorational</p>

                <p>Upon opening, the program displays a window saying "Cat-Like Typing Detected".</p>

                <img src={img1.src} alt="A window open in Windows 10, showing a program with the title PawSense and a big caption Cat-Like Typing Detected" />

                <p>For the user to discard this message, they either have to click the button in the middle or type "human" or "terminate" in the box below.</p>

                <p>
                    <a href="https://git.the-wired.club/lain/CatLikeBehaviourDetected/releases">
                        <button>Download</button>
                    </a>
                    <a href="https://git.the-wired.club/lain/CatLikeBehaviourDetected">
                        <button>View the source code</button>
                    </a>
                    <a href="https://forums.lunya.pet/viewforum.php?f=13w">
                        <button>Discuss the project (Forums)</button>
                    </a>
                    <a href="/discord">
                        <button>Discuss the project (Discord)</button>
                    </a>
                </p>
            </main>
            <Footer />
        </div>

        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
