---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";
---

<!doctype html>
<html lang="en">
<head>
    <Meta name="<PROJECT TITLE>" description="<SHORT PROJECT DESCRIPTION>"/>
    <Scripts/>
    <Cursor/>
</head>

<body>
<canvas id="background"></canvas>
<!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
<div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
    <Header/>
    <main>
        <h1><!-- Title of project --></h1>
        <p>
            <!-- Short project description -->
        </p>
        <p>
            <!-- Description of the project goes here -->
        </p>
        <p>
            <a href="<insert link to project>">
                <button>Download</button>
            </a>
        </p>
    </main>
    <Footer/>
</div>
<script is:inline defer src="/scripts/background.js"></script>
</body>
</html>
