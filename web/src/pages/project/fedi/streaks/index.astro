---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Fedi Streaks" description="This bot counts consecutive days of you posting on fedi." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Fedi Streaks</h1>
                <p>This bot counts consecutive days of you posting on fedi.</p>
                <p>Fedi Streaks checks your profile every day for new notes. If it doesn't find you posting for one day, you lose the streak. Every day you post, you get +1 streaks of sending notes.</p>
                <p>
                    This bot mainly derives from Chat Streaks in Akabot, which is pretty much this but for Discord. The bot follows back within 30 seconds which allows you to check that it actually works. (If Lunya's Sharkey instance is up,
                    there's a high chance this is up as well).
                </p>
                <p>Fedi streaks had very low usage on fedi, so the main instance of it was shut down. But if you want to host an instance for yourself, the source code is below.</p>
                <p>
                    <a href="https://git.lunya.pet/Lunya/fedi-streaks">
                        <button>Source code</button>
                    </a>
                </p>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
