---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="FediMeow" description="This is a bot that meows every hour on fedi." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Fedi Meow</h1>
                <p>This is a bot that meows every hour on fedi.</p>
                <p>This bot is really simple. It sends a message containing meow or nya, randomly adding a tidlie or a :3 to the message.</p>

                <p>Because of low usage, the main instance of fedi meow was shut down because it polluted the DB. But if you want to run this, the code will forever be available.</p>

                <p>
                    <a href="https://git.the-wired.club/lain/fedimeow">
                        <button>Source code</button>
                    </a>
                </p>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
