---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";

import collabMarkovSrc from "./collabmarkov.jpg";
import { getImage } from "astro:assets";

const collabMarkov = await getImage({ src: collabMarkovSrc });
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="FediMeow" description="This is a bot that meows every hour on fedi." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Collaborative Markov Bot</h1>

                <img src={collabMarkov.src} alt="Collaborative Markov bot's profile, with some fire effect over it and a few posts overlaid over each other." />

                <h2>This bot is very silly :3</h2>

                <p>
                    When you follow the bot, the bot will add your posts into its corpus and follow you to get more. When 180 people follow an instance of this bot, very silly things are bound to happen. The best posts are pinned on the
                    profile of the bot itself, so if you want to check them out, check the profile below.
                </p>

                <p>Users who want to follow the bot but not be part of the corpus can add <code>#NoMarkov</code> inside their bio to make the bot not interact with them <strong>at all.</strong></p>

                <p>
                    <a href="https://fedi.lunya.pet/@collabmarkov">
                        <button>Official account (feel free to follow!)</button>
                    </a>
                    <a href="https://git.lunya.pet/Lunya/collabmarkov">
                        <button>Source code</button>
                    </a>
                </p>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
