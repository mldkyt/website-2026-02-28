---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Collaborative Markov Bot" description="The Collaborative Markov Bot is a fedi bot that takes posts from every follower it gets and generates a markovified post from that." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>The best shitposts by Collaborative Markov Bot</h1>
                <p>This page shows the best shitposts generated by Collaborative Markov Bot, calculated using a simple algorithm based on favorites, boosts, replies and post age.</p>
                <p><a href="/project/collabmarkov">Back</a></p>

                {"[[range .Shitposts]]"}
                <div style="border: 1px solid white; padding: 2px; margin: 2px;">
                    <p style="margin: 4px;">[[.Text]]</p>
                    <p style="margin: 0; margin-left: 4px;"><small>[[.Favorites]] favorites, [[.Boosts]] boosts</small></p>
                    <p style="margin: 0; margin-left: 4px;"><a href="[[.Link]]" target="_blank">View post on original instance</a></p>
                </div>
                {"[[end]]"}

                <p>
                    <a href="https://gts.lunya.pet/@collabmarkov">
                        <button>Follow the bot</button>
                    </a>
                </p>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
