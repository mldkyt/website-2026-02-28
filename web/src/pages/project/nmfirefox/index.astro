---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";


import mainSrc from './main.png';
import {getImage} from "astro:assets";

const main = await getImage({src: mainSrc});
---

<!doctype html>
<html lang="en">
    <head>
    <Meta name="Nexusmods Enhancements for Firefox"
          description="This is an extension for Firefox which adds a few features to Nexus Mods, namely blocking people."/>
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Nexus Enhancements for Firefox</h1>
                <p>This is an extension for Firefox which adds a few features to Nexus Mods, namely blocking people.</p>
                <p>
            The extension was made initially for personal use only, hence it not being available on Firefox Extension
            Store, only being on GitHub. By using this extension, you are viable for all damages, even if this shouldn't
            cause
                    any, unless NexusMods updates.
                </p>
                <img src={main.src} alt="User Interface">
                <p>
            The UI allows adding blocked people by username. Blocking a person will hide their comments and replies.
            Unblocking a person requires reload to re-show any hidden comments.
                </p>
                <p>
            To download and install this extension, follow the link to the download and download the <code>xpi</code>
            file while using Firefox. The extension should install.
                </p>

                <p>
                    <a href="https://git.lunya.pet/Lunya/NexusEnhancementsForFirefox/releases">
                        <button>Download</button>
                    </a>
                    <a href="https://matrix.to/#/@mld:mldchan.dev">
                        <button>Message me on Matrix about this project</button>
                    </a>
                </p>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
