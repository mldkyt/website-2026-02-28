---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Mon Bazou Mod List" description="This is the Mon Bazou mod list. It lists mods, shows their settings, and has more features coming soon." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>

        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Mon Bazou Mod List</h1>

                <p>The Mon Bazou Mod List is a simple mod menu for Mon Bazou. It adds a list of mods, where you can view, modify and disable/enable each mod.</p>

                <h2>Features:</h2>
                <ul>
                    <li><strong>Mod List</strong>: Shows mods currently installed. Allows changing settings.</li>
                </ul>

                <h2>Upcoming Features:</h2>
                <ul>
                    <li><strong>Console</strong>: A hidden in-game console that shows messages when needed. Opened by a keyboard shortcut or event.</li>
                    <li><strong>Remote Updates</strong>: Get updates from a remote server and ask users if they want them.</li>
                    <li>Community suggestions welcome!</li>
                </ul>

                <h2>Downloads</h2>
                <p>
                    <a href="https://www.nexusmods.com/monbazou/mods/288">Download from NexusMods</a>
                    <a href="https://git.the-wired.club/lain/MonBazouModMenu/releases">Download from GitHub</a>
                </p>

                <h2>Additional</h2>
                <p>
                    <a href="https://git.the-wired.club/lain/MonBazouModMenu">Source code (Issues available)</a>
                </p>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
