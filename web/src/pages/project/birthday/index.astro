---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
import Scripts from "@components/scripts.astro";

import configSrc from "./config.png";
import addSrc from "./add.png";
import { getImage } from "astro:assets";

const config = await getImage({ src: configSrc });
const add = await getImage({ src: addSrc });
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Birthday" description="Forces you to wish birthday to anyone in your circle so you never forget." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Birthday</h1>
                <p>Forces you to wish birthday to anyone in your circle so you never forget.</p>

                <h2>Configuration</h2>
                <p>Running the app with <code>/config</code> as a parameter will show a configuration window.</p>
                <img src={config.src} alt="Configuration Window" />
                <img src={add.src} alt="Add new birthday Window" />

                <p>To add a new birthday, click on Actions &gt; Add new birthday.</p>
                <p><strong>Don't forget to save your birthdays before exiting the application! File &gt; Save changes</strong></p>
                <p>Please note that because of this app being old, there is a link pointing to mldkyt.com, which doesn't work.</p>

                <p>
                    <a href="https://git.lunya.pet/Lunya/Birthday/releases">
                        <button>Download latest release</button>
                    </a>
                    <a href="https://forums.lunya.pet/viewforum.php?f=12">
                        <button>Discuss the project (Forums)</button>
                    </a>
                    <a href="/discord">
                        <button>Discuss the project (Discord)</button>
                    </a>
                    <a href="/irc">
                        <button>Discuss the project (IRC)</button>
                    </a>
                </p>
            </main>
            <Footer />
        </div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
