---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="NekoChat" description="Chat across websites" />
        <Scripts />
        <Cursor />
        <style>
            .error {
                border: 1px solid red;
                background-image: linear-gradient(to bottom, rgb(136, 0, 0) 20%, rgb(78, 0, 0) 50%, rgb(150, 1, 1) 100%);
                padding: 2px;
            }
        </style>
        <script type="text/javascript" defer src="https://nekochat.mldchan.dev/js/nekochat.js" />
        <link rel="stylesheet" href="https://nekochat.mldchan.dev/css/nekochat.css" />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
        <Header />
        <main>
            <h1>Nekochat!</h1>
            <br />
            <br />
            
            
            <h2>Try out NekoChat!</h2>
            <br/>

            <div class="nekochat-container" style="width: 450px; height: 600px; position: relative !important; overflow-y: auto;">
                <div class="nekochat-chat-box">
                    <div class="nekochat-message-list" id="nekochat-messages"></div>
                    
                    <form class="nekochat-message-form" method="POST" action="https://nekochat.mldchan.dev/chat" style="position: absolute; background-color: black;">
                        <input type="text" id="username" name="username" placeholder="Enter your username" required>
                        <textarea id="message" name="content" placeholder="Type your message here..." required></textarea>
                        <button type="submit">Send Message</button>
                        <span>Report abuse to <a href="mailto:mldkyt@proton.me">mldkyt@proton.me</a>.</span>
                    </form>
            
                    <!-- This allows more people to get to this project, please keep this! -->
                    <a href="https://nekochat.mldchan.dev/" class="nekochat-add-me" style="position: absolute;">
                        <button>+</button>
                    </a>
                </div>
            </div>
            <br/>
            <br/>

            <h2>Embed nekochat in your website!</h2>
            <p>learn how to <a href="https://nekochat.mldchan.dev/">embed the NekoChat widget</a> and <a href="https://nekochat.mldchan.dev/embedding/">style it</a>.</p>

            <a href="https://matrix.to/#/@mld:mldchan.dev">
                <button>Message me on Matrix about this project</button>
            </a>
        </main>
    <Footer/>
</div>
        <script is:inline defer src="/scripts/background.js"></script>
    </body>
</html>
