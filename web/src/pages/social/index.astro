---
import "@styles/global.module.css";
import Header from "@components/header.astro";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import socialStyles from "@styles/socialList.module.css";
import Cursor from "@components/cursor.astro";
import { getImage } from "astro:assets";

import youtubeOrig from "./youtube.png";
import forgejoOrig from "./forgejo.png";
import twitchOrig from "./twitch.png";
import sharkeyOrig from "./sharkey.png";
import peertubeOrig from "./peertube.jpg";
import forumsOrig from "./forums.png";
import discordOrig from "./discord.png";
import nexusmodsOrig from "./nexusmods.jpg";

const youtube = await getImage({ src: youtubeOrig });
const forgejo = await getImage({ src: forgejoOrig });
const twitch = await getImage({ src: twitchOrig });
const sharkey = await getImage({ src: sharkeyOrig });
const peertube = await getImage({ src: peertubeOrig });
const forums = await getImage({ src: forumsOrig });
const discord = await getImage({ src: discordOrig });
const nexusmods = await getImage({ src: nexusmodsOrig });
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Lunya's Social Accounts" description="All of Lunya's social accounts, whether they're social or not." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Lunya's socials</h1>
                <h2>The Community</h2>
                <p>You can join Lunya's community using this Discord link:</p>
                <div class={socialStyles.socialContainer}>
                    <a href="/discord">
                        <div class={socialStyles.social} style={`background-image: url(${discord.src});`}>
                            <h3>Discord Server</h3>
                        </div>
                    </a>
                    <a href="https://forums.lunya.pet">
                        <div class={socialStyles.social} style={`background-image: url(${forums.src});`}>
                            <h3>Forums</h3>
                        </div>
                    </a>
                </div>
                <h2>Social Networks</h2>
                <div class={socialStyles.socialContainer}>
                    <a href="https://the-wired.club/users/lain">
                        <div class={socialStyles.social} style={`background-image: url(${sharkey.src});`}>
                            <h3>The Fediverse (@lain@the-wired.club)</h3>
                        </div>
                    </a>
                    <a href="https://pt.lunya.pet/c/lunyavids">
                        <div class={socialStyles.social} style={`background-image: url(${peertube.src});`}>
                            <h3>Federated videos (@lunyavids@pt.lunya.pet)</h3>
                        </div>
                    </a>
                    <a href="https://www.youtube.com/channel/UC7JMha1kjOS7gsJXwNtosNw">
                        <div class={socialStyles.social} style={`background-image: url(${youtube.src});`}>
                            <h3>YouTube (@LunyaUwU)</h3>
                        </div>
                    </a>
                    <a href="https://git.the-wired.club/lain">
                        <div class={socialStyles.social} style={`background-image: url(${forgejo.src});`}>
                            <h3>Forgejo (Lunya on git.the-wired.club)</h3>
                        </div>
                    </a>
                    <a href="https://www.twitch.tv/lunyacatgirl">
                        <div class={socialStyles.social} style={`background-image: url(${twitch.src});`}>
                            <h3>Twitch (@lunyacatgirl)</h3>
                        </div>
                    </a>
                    <a href="https://www.nexusmods.com/profile/gothcatgrl">
                        <div class={socialStyles.social} style={`background-image: url(${nexusmods.src});`}>
                            <h3>NexusMods (@gothcatgrl)</h3>
                        </div>
                    </a>
                </div>

                <p>Also check out my <a href="/discord">Discord server</a> and <a href="https://forums.lunya.pet" target="_blank">forums</a>.</p>

                <h2>Other accounts</h2>

                <p>A brief list of accounts:</p>

                <ul>
                    <li><a href="https://github.com/c4tgrl">GitHub (Unused)</a></li>
                    <li><a href="https://gitlab.com/catgrl">GitLab.com (catgrl)</a></li>
                    <li><a href="https://git.gay/catgirl">git.gay (Lunya)</a></li>
                    <li><a href="https://codeberg.org/c4tgirl">Codeberg (c4tgirl)</a></li>
                    <li><a href="https://namemc.com/profile/gothcatgrl.1">NameMC (gothcatgrl)</a></li>
                    <li><a href="https://e-z.bio/lunya">E-Z bio (lunya)</a></li>
                </ul>

                <Footer />
            </main>
            <script is:inline defer src="/scripts/background.js"></script>
        </div>
    </body>
</html>
