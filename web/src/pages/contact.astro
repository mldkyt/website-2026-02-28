---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Lunya" description="Lunya is a cute girl programmer making projects, YouTube videos and sometimes streams." />
        <Scripts />
        <Cursor />
        <script type="text/javascript" defer src="https://nekochat.mldchan.dev/js/nekochat.js"></script>
        <link rel="stylesheet" href="https://nekochat.mldchan.dev/css/nekochat.css" />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Contact Lunya :3</h1>

                <p>There are various ways to contact me:</p>

                <ul>
                    <li>
                        <strong>Anonymous Messages</strong>: <a href="/anonymous-message">Send me an anonymous message</a> and I'll answer it publicly on <a href="https://fedi.lunya.pet/@Lunya">my fediverse instance!</a>
                    </li>
                    <li>
                        <strong>Discord</strong>: Add me on Discord, my username is <code>lunya.pet</code>.
                    </li>
                    <li>
                        <strong>Guestbook(s)</strong>: Fill out <a href="/guestbook">this guestbook</a> and I'll answer it publicly on the same site.
                    </li>
                    <li>
                        <strong>Email</strong>: Send me an email at <a href="mailto:lunya.pet@proton.me">lunya.pet@proton.me</a>. <a href="/pgp">You can use my PGP key from here.</a>.
                    </li>
                </ul>
            </main>

            <Footer />
        </div>
        <script is:inline src="/scripts/background.js"></script>
    </body>
</html>
