---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Lunya" description="Lunya is a cute girl programmer making projects, YouTube videos and sometimes streams." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Contact Lunya :3</h1>

                <br />
                <h2>Community</h2>

                <p>These are socials that you can use to join and chat with my community.</p>

                <li>
                    <strong>Discord</strong>: Join my <a href="/discord">Discord server</a>
                </li>
                <li>
                    <strong>Forums</strong>: Create an account on <a href="https://forums.lunya.pet">forums.lunya.pet</a> and send me a DM from there.
                </li>
                <li>
                    <strong>IRC</strong>: No account required. Go to <a href="/irc">IRC</a> for more information.
                </li>

                <br />
                <h2>Personal/Direct</h2>

                <li>
                    <strong>Email</strong>: Send me an email at <a href="mailto:lunya@murena.io">lunya@murena.io</a>. <a href="/pgp">You can use my PGP key from here</a>.
                </li>
                <li>
                    <strong>Fedi</strong>: Send a DM on fedi to <code>@lunya@sk.lunya.pet</code>.
                </li>

                <br />
            </main>
            <Footer />
        </div>

        <script is:inline src="/scripts/background.js"></script>
    </body>
</html>
