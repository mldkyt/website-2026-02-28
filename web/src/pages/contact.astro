---
import Header from "@components/header.astro";
import "@styles/global.module.css";
import Scripts from "@components/scripts.astro";
import Footer from "@components/footer.astro";
import Meta from "@components/meta.astro";
import Cursor from "@components/cursor.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <Meta name="Lunya" description="Lunya is a cute girl programmer making projects, YouTube videos and sometimes streams." />
        <Scripts />
        <Cursor />
    </head>

    <body>
        <canvas id="background"></canvas>
        <!-- God damnit, I'm forced to use inline styles because Astro is stupid -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <Header />
            <main>
                <h1>Contact Lunya :3</h1>

                <p>There are various ways to contact me:</p>

                <ul>
                    <li>
                        <strong>Discord</strong>: <a href="/discord">Join my Discord server</a>.
                    </li>
                    <li>
                        <strong>Email</strong>: Send me an email at <a href="mailto:lunya@murena.io">lunya@murena.io</a>. <a href="/pgp">You can use my PGP key from here</a>.
                    </li>
                    <li>
                        <strong>Matrix</strong>: Send me a message on <a href="https://matrix.to/#/@lunya:lunya.pet">@lunya:lunya.pet</a>
                    </li>
                </ul>
            </main>

            <Footer />
        </div>
        <script is:inline src="/scripts/background.js"></script>
    </body>
</html>
