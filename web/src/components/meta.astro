---
interface Props {
    name: string;
    description: string;
}

let { name, description } = Astro.props;
---

<meta charset="UTF-8" />
<title>{name} | Lunya's website</title>
<meta name="description" content={description} />
<meta name="author" content="Lunya" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="content-language" content="en" />
<meta property="og:title" content={`${name} | Lunya's website`} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://lunya.pet" />
<meta property="og:site_name" content="Lunya's website" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:title" content={`${name} | Lunya's website`} />
<meta name="twitter:description" content={description} />
<meta name="google-adsense-account" content="ca-pub-8084458114757284" />
