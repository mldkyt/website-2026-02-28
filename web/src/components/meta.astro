---
interface Props {
    name: string;
    description: string;
}

let { name, description } = Astro.props;
---

<meta charset="UTF-8" />
<title>{name} | lain's website</title>
<meta name="description" content={description} />
<meta name="author" content="lain" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="content-language" content="en" />
<meta property="og:title" content={`${name} | lain's website`} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://lunya.pet" />
<meta property="og:site_name" content="lain's website" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:title" content={`${name} | lain's website`} />
<meta name="twitter:description" content={description} />
<meta name="fediverse:creator" content="lain@the-wired.club" />
